rules_version = '2';

// Noted — Firestore security rules
// Data model:
//   users/{uid}     : { uid, email, emailLower, firstName, lastName, displayName, photoURL, createdAt }
//   folders/{id}    : { name, parentId, createdBy, createdAt }
//   notes/{id}      : { title, userId (owner), collaborators: [uid] (editors),
//                       viewers: [uid] (read-only), folderId, ydocState,
//                       snapshot, deletedAt, createdAt, updatedAt }
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwnerField(field) {
      return signedIn() && request.auth.uid == resource.data[field];
    }

    // ---- Users ----
    // Any signed-in user may read profiles (needed to resolve collaborators by
    // email and render their names/avatars, like a Docs share dialog).
    // A user may only create/modify their own profile document.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- Folders ----
    match /folders/{folderId} {
      allow read: if isOwnerField('createdBy');
      allow create: if signedIn()
                    && request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if isOwnerField('createdBy');
    }

    // ---- Notes ----
    function isNoteOwner() {
      return signedIn() && request.auth.uid == resource.data.userId;
    }
    function isCollaborator() {
      return signedIn()
             && resource.data.collaborators is list
             && request.auth.uid in resource.data.collaborators;
    }
    // Viewers have read-only access.
    function isViewer() {
      return signedIn()
             && resource.data.viewers is list
             && request.auth.uid in resource.data.viewers;
    }

    match /notes/{noteId} {
      allow read: if isNoteOwner() || isCollaborator() || isViewer();

      allow create: if signedIn()
                    && request.auth.uid == request.resource.data.userId;

      // Owner has full control. Collaborators (editors) may edit content but may
      // not take ownership away from the owner. Viewers get no write access.
      allow update: if isNoteOwner()
                    || (isCollaborator()
                        && request.resource.data.userId == resource.data.userId);

      allow delete: if isNoteOwner();

      // ---- Saved versions (history snapshots) ----
      // Access follows the parent note: anyone who can read the note can read
      // its history; editors and the owner can save versions; only the owner
      // can prune them.
      function parentNote() {
        return get(/databases/$(database)/documents/notes/$(noteId)).data;
      }
      match /versions/{versionId} {
        allow read: if signedIn() && (
          parentNote().userId == request.auth.uid
          || (parentNote().collaborators is list
              && request.auth.uid in parentNote().collaborators)
          || (parentNote().viewers is list
              && request.auth.uid in parentNote().viewers)
        );
        allow create: if signedIn() && (
          parentNote().userId == request.auth.uid
          || (parentNote().collaborators is list
              && request.auth.uid in parentNote().collaborators)
        );
        allow delete: if signedIn() && parentNote().userId == request.auth.uid;
      }
    }

    // ---- Public share mirrors ----
    // A point-in-time, read-only copy of a note published to a public link.
    // Anyone (signed in or not) may read it; only the owner who created it may
    // write or remove it.
    match /publicShares/{token} {
      allow read: if true;
      allow create, update: if signedIn()
                            && request.auth.uid == request.resource.data.ownerId;
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }
  }
}
