# Noted — environment configuration
# Copy to `.env` and fill in. All values are optional: the app ships with the
# demo Firebase project's public web config as fallbacks, so it runs out of the box.

# --- Firebase web config (public; safe to expose in a client bundle) ---
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# --- Real-time collaboration (optional) ---
# Collaboration works with no extra server (synced over Firestore). Set this to a
# y-websocket server URL to additionally enable low-latency sync and live cursors.
# Run one locally with:  npm run collab-server
REACT_APP_COLLAB_WS_URL=
